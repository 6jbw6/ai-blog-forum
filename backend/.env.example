DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_blog
JWT_SECRET_KEY=your_jwt_secret_key

# 运行环境：development | production。上线必须显式改成 production，
# 否则 JWT 密钥缺失时不会拒绝启动，而是每次重启生成临时随机密钥（全站登录态作废）
APP_ENV=development

# 大模型配置 (DeepSeek / 通义千问 / 硅基流动 / OpenAI 等兼容服务)
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 是否允许把大模型端点指向内网 / 本机地址（默认 false）。
# 本机跑 Ollama、LM Studio 之类的本地推理服务时才需要打开：
# ALLOW_PRIVATE_LLM_ENDPOINTS=true

# CORS 允许来源（逗号分隔）。生产部署必须改为站点自身域名，如：
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 登录接口单 IP 限流（次数/窗口秒），防撞库爆破
LOGIN_RATE_LIMIT=10/60
# AI 问答接口限流（次数/窗口秒），防匿名刷 LLM 余额
AI_ASK_RATE_LIMIT=6/60
# 注册接口单 IP 限流（次数/窗口秒），防批量灌号与 bcrypt 慢哈希 CPU 放大。
# 办公室 / 机房共用出口 IP 时按需放宽
REGISTER_RATE_LIMIT=5/3600
# 热度计数写入限流（次数/窗口秒）。浏览量与搜索命中都要往去重台账 article_hits 插一行，
# 这道闸拦在插库之前，防高频请求把数据库当压测靶子
HIT_RATE_LIMIT=60/60
# 去重台账保留天数。views_count / search_hits 按「每访客每天一次」去重，
# 台账只是判定依据，过期行在服务启动时清理
HIT_LOG_RETENTION_DAYS=30

# 前面确有可信反向代理（Nginx 等）时才打开：采信 X-Forwarded-For 解析真实客户端 IP。
# 直连部署下打开等于让调用方自己伪造 IP、绕过上面全部限流
TRUST_PROXY_HEADERS=false

# 把每条 SQL 连同参数打进日志（含密码哈希、用户数据）。只在本地排查问题时临时打开
SQL_ECHO=false

# 开放 /docs、/redoc、/openapi.json。生产环境默认关闭，确需开放再置 true
EXPOSE_API_DOCS=false
